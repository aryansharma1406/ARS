{
  "expo": {
    "name": "ARS Admin",
    "slug": "ars-admin",
    "version": "1.0.0",
    "scheme": "ars-admin",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "events.ars.admin",
      "supportsTablet": true
    },
    "android": {
      "package": "events.ars.admin",
      "icon": "./assets/ars-launcher-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ars-launcher-foreground.png",
        "backgroundColor": "#0B0C08"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "33e71100-7295-48bf-92d6-8a4778f2432a"
      }
    },
    "owner": "ars-hospitality"
  }
}
